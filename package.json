{
  "name": "nocobase",
  "private": true,
  "workspaces": [
    "packages/*/*",
    "packages/*/*/*"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "licenses": [
    {
      "type": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    }
  ],
  "scripts": {
    "nocobase": "nocobase-v1",
    "pm": "nocobase-v1 pm",
    "pm2": "nocobase-v1 pm2",
    "dev:umi": "nocobase-v1 dev",
    "dev": "nocobase-v1 dev --rsbuild",
    "dev:client-v2": "nocobase-v1 dev --client-v2-only",
    "demo:journey": "bun --tsconfig-override tsconfig.demo.json scripts/demo-auth-journey.ts",
    "demo:dev": "vite --config vite.config.ts",
    "demo:build": "vite build --config vite.config.ts",
    "demo:typecheck": "tsc --noEmit -p tsconfig.demo.json",
    "demo:deploy": "bun run demo:build && bunx wrangler deploy -c wrangler.worker.json",
    "demo:verify": "bun --tsconfig-override tsconfig.demo.json scripts/demo-verify.ts",
    "demo:collection-journey": "bun --tsconfig-override tsconfig.demo.json scripts/demo-collection-journey.ts",
    "oa:up": "bun --tsconfig-override tsconfig.demo.json scripts/oa-demo-runtime.ts up",
    "oa:stop": "bun --tsconfig-override tsconfig.demo.json scripts/oa-demo-runtime.ts stop",
    "oa:status": "bun --tsconfig-override tsconfig.demo.json scripts/oa-demo-runtime.ts status",
    "oa:seed": "bun --tsconfig-override tsconfig.demo.json scripts/oa-demo-seed.ts",
    "oa:verify": "bun --tsconfig-override tsconfig.demo.json scripts/oa-demo-verify.ts",
    "dev-server": "nocobase-v1 dev --server",
    "start": "nocobase-v1 start",
    "build": "nocobase-v1 build",
    "build:client-v2": "nocobase-v1 build --client-v2-only",
    "tar": "nocobase-v1 tar",
    "test": "nocobase-v1 test",
    "test:server": "nocobase-v1 test:server",
    "test:server-coverage": "nocobase-v1 test-coverage:server",
    "test:client": "nocobase-v1 test:client",
    "test:client-coverage": "nocobase-v1 test-coverage:client",
    "e2e": "nocobase-v1 e2e",
    "ts": "nocobase-v1 test:server",
    "tc": "nocobase-v1 test:client",
    "benchmark": "nocobase-v1 benchmark",
    "perf": "nocobase-v1 perf",
    "docs": "yarn --cwd docs",
    "doc": "nocobase-v1 doc",
    "doc:cn": "nocobase-v1 doc --lang=zh-CN",
    "postinstall": "nocobase-v1 postinstall",
    "lint": "oxlint",
    "lint:typeaware": "oxlint -c .oxlintrc.json --tsconfig tsconfig.oxlint.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "oxlint && oxfmt --check .",
    "pre-commit": "bun scripts/pre-commit.ts",
    "lint:boundaries": "depcruise packages",
    "migrate:verify": "bun scripts/migrate-verify.ts",
    "migrate:dry-run": "bun scripts/migrate-verify.ts --dry-run",
    "clean": "nocobase-v1 clean",
    "changelog": "auto-changelog -p -t keepachangelog",
    "version:alpha": "lerna version prerelease --preid alpha --force-publish=* --no-git-tag-version -m \"chore(versions): publish packages %s\"",
    "release:force": "lerna publish from-package --yes --no-git-tag-version",
    "release": "lerna publish",
    "git-multi": "node scripts/git-multi.js",
    "run:example": "tsx -r dotenv/config -r tsconfig-paths/register ./examples/index.ts"
  },
  "resolutions": {
    "@ant-design/icons": "^5.6.1",
    "@formily/antd-v5": "1.2.3",
    "@rushstack/ts-command-line": "4.23.7",
    "@rspack/core": "1.7.8",
    "@types/react": "18.3.18",
    "@types/react-dom": "^18.0.0",
    "**/@mongodb-js/zstd": "file:./packages/plugins/@nocobase/plugin-ai/npm-shims/@mongodb-js/zstd",
    "**/node-liblzma": "file:./packages/plugins/@nocobase/plugin-ai/npm-shims/node-liblzma",
    "react-router-dom": "^6.30.1",
    "react-router": "^6.30.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "nwsapi": "2.2.7",
    "antd": "5.24.2",
    "dayjs": "1.11.13",
    "**/@rushstack/node-core-library/ajv": "8.18.0",
    "**/pm2/js-yaml": "4.3.2",
    "**/qs": "6.16.0"
  },
  "config": {
    "ghooks": {
      "pre-commit": "bun scripts/pre-commit.ts",
      "commit-msg": "bunx commitlint --edit"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxfmt --write",
      "oxlint --deny-warnings"
    ],
    "*.json": [
      "oxfmt --write"
    ]
  },
  "devDependencies": {
    "@alicloud/cdn20180510": "^9.2.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/prompt-cli": "^21.2.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ali-oss": "^6.23.0",
    "auto-changelog": "^2.7.0",
    "dependency-cruiser": "^18.4.0",
    "ghooks": "^2.0.4",
    "joi": "^18.2.9",
    "lint-staged": "^17.6.0",
    "loadjs": "^4.3.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "patch-package": "^8.0.1",
    "playwright": "^1.63.0",
    "pm2": "^7.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "safe-load-script": "^0.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.144.0"
  },
  "volta": {
    "node": "20.16.0",
    "yarn": "1.22.19"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "antd": "^6.6.5",
    "better-auth": "1.6.11",
    "convex": "^1.46.0",
    "i18next": "^26.4.2",
    "react-i18next": "^17.0.15"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
